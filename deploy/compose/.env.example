# Compose 部署环境变量（复制为 .env 后填写）
# 模型配置在 config 里（data/config/model-proxy/config/model_list.json），这里只放本文件用到的端口与外部端点

# ── 对外端口 ─────────────────────────────────────────────
GATEWAY_PORT=5210
FRONTEND_PORT=8080
DASHBOARD_PORT=5700
IMAGE_ASSETS_PORT=5102

# ── 可选功能的对外地址 ────────────────────────────────────
OPENVIKING_PORT=1933
SEARXNG_PORT=8080
# tool-runtime 用；空 = 用内置回落
SEARXNG_URL=
BROWSER_MCP_URL=
BROWSER_CDP_URL=

# ── 可选功能开关（默认全关，与 features.json 的 minimal 预设一致）──
ENABLE_CODEX=false
ENABLE_CLAWHUB=false
ENABLE_OPENVIKING=false
CLAW_DOWNLOAD_MODE=local

# ── QQ（profile qq）──────────────────────────────────────
# 对方已有 Satori（我们 llbot 或别人家的）时填这里；host.docker.internal = 宿主机
SATORI_HOST=host.docker.internal
SATORI_PORT=5600
SATORI_TOKEN=

# ── 本地模型（profile ollama）────────────────────────────
OLLAMA_PORT=11434

# ── QQ OneBot（profile qq-onebot）───────────────────────
# forward：我们连 NapCat 的 ws；reverse：NapCat 连我们（listen）
ONEBOT_MODE=forward
ONEBOT_WS_URL=ws://host.docker.internal:3001/
ONEBOT_WS_LISTEN=0.0.0.0:6700
ONEBOT_TOKEN=
ONEBOT_SELF_ID=
ONEBOT_GROUP_REQUIRE_AT=true
ONEBOT_REVERSE_PORT=6700
