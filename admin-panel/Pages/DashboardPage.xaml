<Page x:Class="MyAgentAdminPanel.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Title="Dashboard">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Dashboard"
                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnRefresh" Content="🔄 刷新"
                        Width="70" Height="30" Margin="0,0,8,0"
                        Cursor="Hand" Click="BtnRefresh_Click"/>
                <Button x:Name="BtnOpenBrowser" Content="🌐 在浏览器打开"
                        Width="120" Height="30"
                        Cursor="Hand" Click="BtnOpenBrowser_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- WebView2 嵌入 -->
            <wv2:WebView2 x:Name="DashboardWebView"/>

            <!-- 加载失败时的提示 -->
            <Border x:Name="ErrorOverlay" Background="White" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⚠️ 无法连接 Dashboard"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#D32F2F"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="请先到「端口转发」页面启动 dashboard 端口转发"
                               FontSize="13" Foreground="#666"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                    <TextBlock FontSize="13" Foreground="#999"
                               HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Run Text="目标地址："/>
                        <Run Text="http://localhost:5601" FontFamily="Consolas"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
