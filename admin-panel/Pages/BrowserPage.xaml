<Page x:Class="MyAgentAdminPanel.Pages.BrowserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="浏览器环境"
      Background="#F3F3F3">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="🌐 浏览器环境（Edge + CDP）"
                       FontSize="22" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock Text="让智能体操作宿主上的 Edge：起调试端口 → 本面板进程内中继 → 容器发布端口给集群。全部由本面板执行，不写注册表、不开机自启。"
                       Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="状态" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtStatus" FontFamily="Consolas" FontSize="13"
                               TextWrapping="Wrap" Foreground="#333"/>
                    <Button x:Name="BtnRefresh" Content="刷新状态" Width="110"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="BtnRefresh_Click"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="操作" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button x:Name="BtnStartAll" Content="启动全部" Width="120" Height="34" Margin="0,0,10,10"
                                Click="BtnStartAll_Click"/>
                        <Button x:Name="BtnStartEdge" Content="只起 Edge" Width="110" Height="34" Margin="0,0,10,10"
                                Click="BtnStartEdge_Click"/>
                        <Button x:Name="BtnStopRelay" Content="停止转发" Width="110" Height="34" Margin="0,0,10,10"
                                Click="BtnStopRelay_Click"/>
                        <Button x:Name="BtnOpenDashboard" Content="打开面板" Width="110" Height="34" Margin="0,0,10,10"
                                Click="BtnOpenDashboard_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Edge 路径" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtEdgePath" Height="30" Margin="0,0,8,8"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="自动检测" Height="30" Margin="0,0,0,8"
                                Click="BtnDetectEdge_Click"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Profile 目录" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtProfileDir" Height="30" Margin="0,0,8,8"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="选择…" Height="30" Margin="0,0,0,8"
                                Click="BtnPickProfile_Click"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="端口（调试/中继/发布）" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtPorts" Height="30" Margin="0,0,8,0"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="保存设置" Height="30"
                                Click="BtnSave_Click"/>
                    </Grid>
                    <TextBlock Text="端口格式：9222,9223,9224（调试端口 / 宿主中继 / 容器发布）。保存后需重新点「启动全部」。"
                               Foreground="#888" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="日志" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtLog" Height="160" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                             TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
