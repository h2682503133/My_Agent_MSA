<Page x:Class="MyAgentAdminPanel.Pages.DeployPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="一键部署"
      Background="#F3F3F3">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="🚀 一键部署（按功能）" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnReload" Content="↻ 读取功能清单" Width="120" Height="30" Margin="0,0,8,0"
                        Click="BtnReload_Click"/>
                <Button x:Name="BtnPreview" Content="🧾 预览计划" Width="110" Height="30" Margin="0,0,8,0"
                        Click="BtnPreview_Click"/>
                <Button x:Name="BtnDeploy" Content="🚀 构建并部署" Width="130" Height="30" Click="BtnDeploy_Click"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="选择功能（默认最简运行）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FeaturePanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="功能所需信息 / 计划预览" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="SettingsPanel"/>
                            <TextBlock Text="计划预览" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <TextBox x:Name="TxtPlan" Height="180" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                     Background="#FAFAFA"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="部署日志" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="8">
            <RichTextBox x:Name="LogOutput" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" Background="#FAFAFA"/>
        </Border>
    </Grid>
</Page>
