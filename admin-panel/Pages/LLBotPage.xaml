<Page x:Class="MyAgentAdminPanel.Pages.LLBotPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="LLBot">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="LLBot 控制"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- LLBot 启动器 exe（新版 LuckyLillia.exe / 旧版 llbot.exe，直接选文件） -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="LLBot 启动器："
                       VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="TxtExePath"
                     Height="30" VerticalContentAlignment="Center"
                     TextChanged="TxtExePath_TextChanged"/>
            <Button Grid.Column="2" Content="浏览..."
                    Width="60" Height="30" Margin="8,0"
                    Cursor="Hand" Click="BtnBrowseExe_Click"/>
        </Grid>

        <!-- 自动识别结果（布局 / 版本 / 数据目录）+ 运行模式 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock x:Name="TxtLlbotInfo"
                       FontSize="11" Foreground="#777" TextWrapping="Wrap"
                       Margin="0,0,0,6"
                       Text="选择安装根目录下的启动器 exe：新版 LuckyLillia.exe（CLI 版仍是 llbot.exe），旧版 llbot.exe。程序按目录结构自动识别版本。"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="运行模式：" VerticalAlignment="Center"
                           FontSize="12" Foreground="#444" Margin="0,0,6,0"/>
                <ComboBox x:Name="CmbMode" Width="360" Height="26" FontSize="12"
                          VerticalContentAlignment="Center"
                          SelectionChanged="CmbMode_SelectionChanged">
                    <ComboBoxItem Content="PMHQ（真实 QQ 客户端，需在 QQ 窗口里扫码）"/>
                    <ComboBoxItem Content="headless（LLBot 直连，二维码直接显示在面板）"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- QQ 路径 + 启动按钮 -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="QQ 程序路径："
                       VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="TxtQqPath"
                     Height="30" VerticalContentAlignment="Center"
                     TextChanged="TxtQqPath_TextChanged"/>
            <Button Grid.Column="2" Content="浏览..."
                    Width="60" Height="30" Margin="8,0"
                    Cursor="Hand" Click="BtnBrowseQq_Click"/>
            <Button Grid.Column="3" x:Name="BtnStartStop"
                    Content="▶ 启动"
                    Width="80" Height="30" Margin="8,0,0,0"
                    Background="#0078D4" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnStartStop_Click"/>
            <Button Grid.Column="4" x:Name="BtnCleanup"
                    Content="🧹 清理残留"
                    Width="96" Height="30" Margin="8,0,0,0"
                    Background="#F5F5F5" BorderBrush="#CCC"
                    Foreground="#444" Cursor="Hand"
                    ToolTip="结束安装目录下仍在运行的启动器 / PMHQ / 内嵌 node（面板关闭后残留的那些）"
                    Click="BtnCleanup_Click"/>
        </Grid>

        <!-- 主体：日志 + 二维码 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8">
                <RichTextBox x:Name="LogOutput"
                             IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             Foreground="#D4D4D4"
                             Background="Transparent"
                             BorderThickness="0" Margin="12"
                             VerticalScrollBarVisibility="Auto"/>
            </Border>

            <Border Grid.Column="1" Margin="16,0,0,0"
                    Background="White" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="二维码" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Image x:Name="QrCodeImage"
                           Width="200" Height="200"
                           Stretch="Uniform" Margin="0,0,0,12"/>
                    <TextBlock Text="暂无二维码"
                               x:Name="TxtQrStatus"
                               FontSize="12" Foreground="#999"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtQrSource"
                               FontSize="11" Foreground="#666"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Expander Header="WebUI 取码设置" FontSize="12" Foreground="#444"
                              IsExpanded="False" Margin="0,0,0,8">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="WebUI 地址" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtWebuiUrl" Height="26" FontSize="12"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TxtWebuiUrl_TextChanged"/>
                            <TextBlock Text="WebUI 密码（填密码即可，自动转 SHA-256）" FontSize="11"
                                       Foreground="#666" Margin="0,8,0,2"/>
                            <TextBox x:Name="TxtWebuiToken" Height="26" FontSize="12"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TxtWebuiToken_TextChanged"/>
                            <TextBlock Text="也可直接填 64 位十六进制的 cookie webui_token。API 可用时优先用 API（带精确过期时间）；不可用自动回落二维码文件（新版 data\temp\login-qrcode.png，旧版 qrcode.png）"
                                       FontSize="10" Foreground="#999" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Expander>

                    <TextBlock Text="二维码网址："
                               FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtQrUrl"
                               FontSize="10" Foreground="#0078D4"
                               TextWrapping="Wrap"
                               Text="https://api.2dcode.biz/v1/create-qr-code?data=..."/>

                    <!-- 新版（PMHQ 模式）：码在 QQ 窗口里，LLBot 读不到属正常 -->
                    <TextBlock x:Name="TxtPmhqHint"
                               FontSize="10" Foreground="#B26A00" TextWrapping="Wrap"
                               Margin="0,8,0,0" Visibility="Collapsed"
                               Text="PMHQ 模式：二维码只画在 QQ 窗口里，面板/WebUI 读不到是正常的 —— 请点下面按钮切到 QQ 窗口扫码或快速登录。"/>
                    <Button x:Name="BtnCaptureQq"
                            Content="📷 截取 QQ 窗口"
                            Height="28" Margin="0,6,0,0"
                            FontSize="12" Cursor="Hand"
                            Background="#FFF4E5" BorderBrush="#E0B070"
                            ToolTip="把 QQ 登录窗口的画面截到这里，直接用手机扫图中二维码"
                            Click="BtnCaptureQq_Click"/>
                    <Button x:Name="BtnFocusQq"
                            Content="🔗 打开 QQ 窗口"
                            Height="28" Margin="0,8,0,0"
                            FontSize="12" Cursor="Hand"
                            Background="#FFF4E5" BorderBrush="#E0B070"
                            Click="BtnFocusQq_Click"/>
                    <Button x:Name="BtnPushQr"
                            Content="📤 推送到 Dashboard"
                            Height="28" Margin="0,12,0,0"
                            FontSize="12" Cursor="Hand"
                            Background="#F5F5F5" BorderBrush="#CCC"
                            Click="BtnPushQr_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
