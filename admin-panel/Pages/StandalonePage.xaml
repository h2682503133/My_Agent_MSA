<Page x:Class="MyAgentAdminPanel.Pages.StandalonePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="单体模式"
      Background="#F3F3F3">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <TextBlock Text="🧩 单体模式（无 Docker / 无 k8s）"
                       FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="只用源码 + Python：面板按功能起一组本地子进程（127.0.0.1），数据都在下面这个目录里。不写注册表、不做开机自启。"
                       Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <!-- 路径与运行时 -->
            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="环境" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="仓库根目录" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtRepoRoot" Height="28" Margin="0,0,8,6"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="自动探测" Height="28" Margin="0,0,0,6" Click="BtnDetect_Click"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="数据目录" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDataDir" Height="28" Margin="0,0,8,0"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="打开" Height="28" Click="BtnOpenDataDir_Click"/>
                    </Grid>
                    <TextBlock Text="Python：面板优先用 publish/runtime/python.exe，其次系统 python.exe"
                               Foreground="#888" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtPython" Foreground="#555" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 配置在哪设 -->
            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="配置在哪设（这里不放重复入口）" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock FontSize="11.5" Foreground="#555" TextWrapping="Wrap"
                               Text="· 模型 / embedding（含 Ollama 地址、模型名、Key）→ dashboard「配置管理」→ model-proxy/config/model_list.json&#10;· QQ 凭据（Satori / OneBot 地址、token）→ dashboard「配置管理」→ qq-llbot/qq_llbot_config.json&#10;· OpenViking Key → dashboard「配置管理」→ openviking/&#10;· 工具权限、世界书、表情绑定、系统提示词 → dashboard 对应页签&#10;· 运行环境与降级原因 → dashboard「杂项」顶部"/>
                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#888" TextWrapping="Wrap"
                               Text="模板会先复制到数据目录（不改仓库里的模板），启动后到 dashboard 填即可；model-proxy 每次请求都会重读配置，不用重启。"/>
                </StackPanel>
            </Border>

            <!-- openviking 记忆 -->
            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="openviking 记忆" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock FontSize="11.5" Foreground="#555" TextWrapping="Wrap"
                               Text="只在「记忆模式 = openviking」时生效。留空 = 记忆用本地文件（不写库、不检索）；填写形如 http://10.0.0.5:1933 即启用。api_key 放 data/config/openviking/api_key。"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="服务器地址" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="TxtOvUrl" Height="28" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="保存" Height="28" Click="BtnSaveOvUrl_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtOvHint" FontSize="11" Foreground="#888" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="保存后需「停止 → 启动」单体模式才生效（写入 data/config/launcher.json）。"/>

                    <CheckBox x:Name="ChkOvLocal" Margin="0,10,0,0"
                              Content="本机自建（不用 Docker；首次安装约 8~10 分钟）"
                              Checked="ChkOvLocal_Changed" Unchecked="ChkOvLocal_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="BtnOvInstall" Content="安装/更新运行环境" Height="28" Padding="10,0" Click="BtnOvInstall_Click"/>
                        <Button x:Name="BtnOvInit" Content="初始化（建账号 + key）" Height="28" Padding="10,0" Margin="8,0,0,0" Click="BtnOvInit_Click"/>
                        <TextBlock x:Name="TxtOvLocalStatus" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" Foreground="#666"/>
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="#888" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="勾选后由单体自己起 OpenViking（独立 venv，端口 1933），不需要服务器地址。embedding 模型默认指向本机 Ollama（qwen3-embedding:0.6b），模型名/地址请在 dashboard「配置管理」里改。"/>
                </StackPanel>
            </Border>

            <!-- 功能 -->
            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="功能（默认只勾最简运行 + 本地记忆）" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="FeatureList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          IsEnabled="{Binding CanToggle}"
                                          Margin="0,2,0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Hint}" Foreground="#888" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="记忆模式：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbMemory" Width="160" Height="26">
                            <ComboBoxItem Content="local" IsSelected="True"/>
                            <ComboBoxItem Content="openviking"/>
                        </ComboBox>
                        <TextBlock Text="QQ 协议：" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <ComboBox x:Name="CmbQq" Width="160" Height="26">
                            <ComboBoxItem Content="satori" IsSelected="True"/>
                            <ComboBoxItem Content="onebot"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 操作 -->
            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <WrapPanel>
                    <Button x:Name="BtnInit" Content="初始化数据目录" Width="130" Height="32" Margin="0,0,8,0" Click="BtnInit_Click"/>
                    <Button x:Name="BtnInstallDeps" Content="安装依赖（共享 venv）" Width="170" Height="32" Margin="0,0,8,0" Click="BtnInstallDeps_Click"/>
                    <Button x:Name="BtnProbe" Content="探测环境" Width="100" Height="32" Margin="0,0,8,0" Click="BtnProbe_Click"/>
                    <Button x:Name="BtnStart" Content="启动" Width="90" Height="32" Margin="0,0,8,0" Click="BtnStart_Click"/>
                    <Button x:Name="BtnStop" Content="停止" Width="90" Height="32" Margin="0,0,8,0" Click="BtnStop_Click"/>
                    <Button x:Name="BtnRefresh" Content="刷新状态" Width="100" Height="32" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
                    <Button x:Name="BtnOpenDashboard" Content="打开 Dashboard" Width="120" Height="32" Click="BtnOpenDashboard_Click"/>
                </WrapPanel>
            </Border>

            <!-- 状态 -->
            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="状态" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtStatus" Height="140" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- 日志 -->
            <Border Background="White" CornerRadius="8" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="日志" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="服务：" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <ComboBox x:Name="CmbLogService" Width="200" Height="26" SelectionChanged="CmbLogService_SelectionChanged"/>
                    </StackPanel>
                    <TextBox x:Name="TxtLog" Height="180" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
